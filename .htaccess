# Hostinger (shared hosting) serves this folder as public_html. Send every request into
# Laravel's public/ folder so project files such as .env, composer.json, vendor/ and
# storage/ are never reachable from the web.
<IfModule mod_rewrite.c>
Options +FollowSymLinks
RewriteEngine On

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<Files .env>
    Order allow,deny
    Deny from all
</Files>
